# FitSync — örnek ortam değişkenleri
# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# .env dosyasını repoya EKLEMEYİN; anahtarlar yalnızca sunucu ortamında tutulur.

# Google Gemini API anahtarı (AI Koç proxy için zorunlu)
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: canlıda frontend URL’i (CORS). Örnek: https://app.example.com
# Boş bırakılırsa yalnızca http://localhost:8080 kabul edilir.
# FITSYNC_PRODUCTION_ORIGIN=
